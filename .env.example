# FastAPI 可选后端环境变量示例:复制为 .env 后按需填写。
# 注意:前端「本地直连」模式下的 API Key 存在浏览器 IndexedDB 里,不读这个文件。
# 只有使用「服务器代理」模式时,后端才需要下面的 AI 配置。

# AI 代理(留空表示后端不代理 AI 请求)
SEP_AI_BASE_URL=https://api.deepseek.com
SEP_AI_API_KEY=
SEP_AI_MODEL=deepseek-chat

# 数据库(默认 SQLite 本地文件;部署到公网时请改用 Postgres 等持久存储)
# SEP_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
